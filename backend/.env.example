# ==========================================
# ELYSEE RESERVAS - Backend
# Variables de entorno
# ==========================================
# Copia este archivo a .env y completa los valores reales.

# --- Aplicacion ---
NODE_ENV=development
PORT=3000

# --- Frontend (para CORS en produccion) ---
# En desarrollo se permite cualquier origen.
# En produccion, lista separada por comas.
FRONTEND_URL=http://localhost:5173

# --- Logging ---
# Niveles: error, warn, info, http, debug
LOG_LEVEL=debug

# --- Base de datos SQL Server ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ElyseeDB
DB_USER=sa
DB_PASSWORD=TuPasswordSegura123!
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- JWT (para futura autenticacion) ---
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=1d