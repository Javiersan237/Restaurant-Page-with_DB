GO

SET NOCOUNT ON;
GO

PRINT '';
PRINT '=====================================================================';
PRINT '  ELYSEE RESERVAS - Tests de Queries';
PRINT '=====================================================================';
PRINT '';

-- Tabla temporal para acumular resultados
