  const r = reservacion || {}
  const cliente = r.cliente || {}
  const mesa = r.mesa || {}
  const agenda = r.agenda || {}

  const idReserva = r.reservacionID ?? r.ReservacionID ?? id
  const numeroPersonas = r.numeroPersonas ?? r.NumeroPersonas
  const estado = r.estado ?? r.Estado ?? 'Pendiente'
