-- Devuelve  : ReservacionID, Fecha, HoraInicio, HoraFin, DuracionMin,
--             NumeroPersonas, Estado, NumeroMesa, Ubicacion, Notas
-- Orden     : Mas recientes primero
-- =====================================================================

USE ElyseeDB;
GO

-- ---------------------------------------------------------------------
-- PARAMETROS (modificar para pruebas)
-- ---------------------------------------------------------------------
DECLARE @ClienteID INT = 1;

-- ---------------------------------------------------------------------
-- QUERY
-- ---------------------------------------------------------------------
SELECT 
    r.ReservacionID,
    a.Fecha,
    a.HoraInicio,
    a.HoraFin,
    a.DuracionMin,
    r.NumeroPersonas,
    r.Estado,
