    m.NumeroMesa,
    m.Ubicacion,
    m.Capacidad
FROM dbo.Reservaciones r
INNER JOIN dbo.Agendas a ON a.AgendaID = r.AgendaID
INNER JOIN dbo.Mesas   m ON m.MesaID   = r.MesaID
