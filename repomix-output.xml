  // Cliente
  const nombreCliente = cliente.nombre
    ? `${cliente.nombre} ${cliente.apellido || ''}`.trim()
    : null
  const emailCliente = cliente.email ?? null

  // Mesa
  const mesaNumero = mesa.numeroMesa ?? r.numeroMesa
